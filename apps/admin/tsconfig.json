{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["./components/*"],
      "@screens/*": ["./screens/*"],
      "@navigation/*": ["./navigation/*"],
      "@store/*": ["./store/*"],
      "@services/*": ["./services/*"]
    }
  },
  "include": ["src/**/*", "App.tsx"]
}
