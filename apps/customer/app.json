{
  "expo": {
    "name": "NeighborHub",
    "slug": "neighborhub-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "neighborhub",
    "splash": {
      "image": "./src/assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#00B060"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neighborhub.customer",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NeighborHub needs your location to show you neighborhood content.",
        "NSLocationAlwaysUsageDescription": "NeighborHub needs your location for safety alerts.",
        "NSCameraUsageDescription": "NeighborHub needs camera access to post photos.",
        "NSPhotoLibraryUsageDescription": "NeighborHub needs photo library access to post photos.",
        "NSMicrophoneUsageDescription": "NeighborHub needs microphone access for video messages.",
        "NSContactsUsageDescription": "NeighborHub needs contacts to find your neighbors."
      },
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_API_KEY"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#00B060"
      },
      "package": "com.neighborhub.customer",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_CONTACTS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow NeighborHub to use your location."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/notification-icon.png",
          "color": "#00B060"
        }
      ],
      "expo-font",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NeighborHub to access your photos.",
          "cameraPermission": "Allow NeighborHub to access your camera."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    },
    "owner": "YOUR_EXPO_ACCOUNT"
  }
}
